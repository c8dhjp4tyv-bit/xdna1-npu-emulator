@@ -5040,6 +5040,12 @@ static void vtd_cap_init(IntelIOMMUState *s)
         s->ecap |= VTD_ECAP_SC;
     }
 
+    /* QEMU's emulated memory is coherent; expose that guarantee to guest
+     * Intel SVM when the vIOMMU SVM mode is explicitly enabled. */
+    if (s->svm) {
+        s->ecap |= VTD_ECAP_SMPWC;
+    }
+
